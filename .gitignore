# ───────────────────────── Rust / Cargo 构建产物 ─────────────────────────
/target/
**/target/
# gungraun 的基线目录（CI 里通过 GUNGRAUN_HOME 指到仓库根）
/.gungraun/
#Cargo.lock

# ───────────────────────── Godot 引擎缓存与导出 ─────────────────────────
.godot/
**/.godot/
/android/
/export/
*.pck
*.translation

# ───────────────────────── Godot GDExtension 动态库产物 ─────────────────────────
/godot-project/bin/

# ───────────────────────── Godot 导出产物（build.sh / CI / 本地导出） ─────────────────────────
/build/

# ───────────────────────── Android release keystore（仅 CI/本地临时，切勿入库） ─────────────────────────
/.android-keystore/

# ───────────────────────── Python 缓存（.github/scripts） ─────────────────────────
__pycache__/
*.pyc

# ───────────────────────── 本地备份（非源码） ─────────────────────────
/.refactor-backup/

# ───────────────────────── 编辑器 / 操作系统 ─────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
